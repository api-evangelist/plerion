{
  "item": [
    {
      "id": "1aaefc02-9d8d-4065-b61a-e4d2f0efbb25",
      "name": "Alerts",
      "description": {
        "content": "The Plerion Risk Score (PRS) Engine has calculated Alerts that are the highest priority items based on the available information across Identity, Configuration, and Vulnerability Management. \nAlerts offer the highest value CONTEXT from across the Plerion Platform. Alerts are accompanied by a narrative to guide customers on the overall risk and the recommended remediation steps to take to improve, reduce, or eradicate the identified risk.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6a1e5dfe-f064-4508-9fe3-755363e36b3b",
          "name": "List",
          "request": {
            "name": "List",
            "description": {
              "content": "Use the list alerts API to get alerts for the tenant.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "tenant",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Filter alerts based on ID of the alert [Plerion Resource Names (prn)]. Accepts a comma-separated list of ids."
                },
                {
                  "disabled": false,
                  "key": "workflowIds",
                  "value": "<string>",
                  "description": "Filter alerts based on Plerion Workflow IDs. Accepts a comma-separated list of workflow ids."
                },
                {
                  "disabled": false,
                  "key": "integrationIds",
                  "value": "<string>",
                  "description": "Filter alerts based on Plerion integration ids. Accepts a comma-separated list of integration ids."
                },
                {
                  "disabled": false,
                  "key": "assetGroupIds",
                  "value": "<string>",
                  "description": "Filter alerts based on asset group ids. Accepts a comma-separated list of asset group ids."
                },
                {
                  "disabled": false,
                  "key": "statuses",
                  "value": "<string>",
                  "description": "Filter alerts based on statuses. Accepts a comma-separated list of statuses."
                },
                {
                  "disabled": false,
                  "key": "resourceTypes",
                  "value": "<string>",
                  "description": "Filter alerts based on provider resource types. Accepts a comma-separated list of resource types."
                },
                {
                  "disabled": false,
                  "key": "providers",
                  "value": "<string>",
                  "description": "Filter alerts based on provider. Accepts a comma-separated list of providers."
                },
                {
                  "disabled": false,
                  "key": "alertTypes",
                  "value": "<string>",
                  "description": "Filter alerts based on alert type. Accepts a comma-separated list of type."
                },
                {
                  "disabled": false,
                  "key": "flagged",
                  "value": "<string>",
                  "description": "Filter alerts based on flag status. Accepts a single value. The supported values are `true` or `false`."
                },
                {
                  "disabled": false,
                  "key": "acknowledged",
                  "value": "<string>",
                  "description": "Filter alerts based on acknowledge status. Accepts a single value. The supported values are `true` or `false`."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "Order the list by supported field"
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "<string>",
                  "description": "The sort order of the list. The parameter sortBy has to be provided to use sortOrder. If sortOrder is not provided the default order is `ASC`."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Get the next batch of alerts. Used for pagination."
                },
                {
                  "disabled": false,
                  "key": "perPage",
                  "value": "<number>",
                  "description": "Specify the batch size of the list. Used for pagination"
                }
              ],
              "variable": [
                {
                  "description": " (This can only be one of au,sg1,in1,us1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
