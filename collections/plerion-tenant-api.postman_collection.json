  "item": [
    {
      "id": "b116883b-c529-4973-9190-60633ed38164",
      "name": "Tenant",
      "description": {
        "content": "The Plerion platform caters for multi-tenancy.\nMulti-tenancy within the Plerion platform delivers isolation for the integrations supported by Plerion. Each Tenancy (Tenant) allows for multiple inbound or outbound integrations, like integrating with Cloud Service Providers (AWS, Azure, GCP), and their corresponding Audit log service (AWS: CloudTrail, Azure: AuditLog, GCP: Cloud Audit Log).",
        "type": "text/plain"
      },
