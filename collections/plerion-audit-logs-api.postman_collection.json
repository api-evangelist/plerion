{
  "item": [
    {
      "id": "eddd0479-d6af-491d-a479-ce5bda774cb6",
      "name": "Audit logs",
      "description": {
        "content": "Audit logs provide a comprehensive trail of user activities and system operations within a tenant.\nThese logs capture important events such as user logins, API calls, configuration changes, and other security-relevant activities. Audit logs help with compliance, security monitoring, and troubleshooting.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5ec90ac7-fa0a-4481-9402-a4837a8401d1",
          "name": "List",
          "request": {
            "name": "List",
            "description": {
              "content": "Use the list audit logs API to retrieve audit trail information for a tenant with filtering options.\nBy default, all audit logs are returned with a page size of 100. You can filter by date range, user, and operation type.\n\nDate range filtering is supported using the `operationTimeStart` and `operationTimeEnd` parameters:\n- `operationTimeStart` alone: Includes audit logs from the specified date to the present.\n- `operationTimeEnd` alone: Includes audit logs up to the specified date.\n- Both provided: Includes audit logs within the specified date range.\n\nDate strings must follow ISO 8601 format (e.g., `2023-02-01T18:09:07Z`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "tenant",
                "audit-logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "operationTimeStart",
                  "value": "<dateTime>",
                  "description": "Start of the date range for filtering audit logs based on operation time. \nSpecify the start of the range using a valid ISO 8601 date-time string. \nIf `operationTimeStart` is provided and `operationTimeEnd` is omitted, \nresults will include audit logs from this date to the present.\nSupported formats include:\n- `yyyy-MM-ddTHH:mm:ssZ` (e.g., `2020-12-18T08:00:00Z`)\n- `yyyy-MM-ddTHH:mm:ss.SSSZ` (e.g., `2020-12-18T08:00:00.000Z`)"
                },
                {
                  "disabled": false,
                  "key": "operationTimeEnd",
                  "value": "<dateTime>",
                  "description": "End of the date range for filtering audit logs based on operation time. \nSpecify the end of the range using a valid ISO 8601 date-time string. \nIf `operationTimeEnd` is provided and `operationTimeStart` is omitted, \nresults will include audit logs up to this date.\nSupported formats include:\n- `yyyy-MM-ddTHH:mm:ssZ` (e.g., `2020-12-18T08:00:00Z`)\n- `yyyy-MM-ddTHH:mm:ss.SSSZ` (e.g., `2020-12-18T08:00:00.000Z`)"
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<string>",
                  "description": "Filter audit logs based on operator user ID."
                },
                {
                  "disabled": false,
                  "key": "operation",
                  "value": "<string>",
                  "description": "Filter audit logs based on operation type."
                },
                {
                  "disabled": false,
                  "key": "perPage",
                  "value": "100",
                  "description": "Specify the batch size of the list. Used for pagination"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Get the next batch of audit logs. Used for pagination. When cursor is provided, the response will not include total count."
                }
              ],
              "variable": [
                {
                  "description": " (This can only be one of au,sg1,in1,us1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
