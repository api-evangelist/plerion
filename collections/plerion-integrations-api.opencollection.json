                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "Specify the batch size of the list. Used for pagination"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor to get next batch of result. Used for pagination"
              },
              {
                "name": "includeTotal",
                "value": "",
                "type": "query",
                "description": "Include the total count of available integrations"
              }
