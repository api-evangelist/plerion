  "item": [
    {
      "id": "d4236d95-f248-4656-8a88-6aa2029ce124",
      "name": "Compliance frameworks",
      "description": {
        "content": "Compliance Frameworks help our customers meet their regulatory and compliance obligations, and reduce compliance risk, enabling them to achieve their strategic objectives.\nPlerion offers customers hundreds of prebuilt detections delivering continuous assurance against industry standards and best practices.",
        "type": "text/plain"
      },
      "item": [
        {
